# Single source of truth for tool versions (CONTEXT §4.1).
# install_node.sh and check_versions.sh both read this file. Change it only with team agreement.
JAVA_MAJOR=11
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.5.3
SCALA_BINARY=2.12
ICEBERG_VERSION=1.6.1
# Driver and executors must run the same Python minor version, or PySpark refuses to start
# Python workers. Nodes 1-3 must all match this. Agree on it as a team before changing.
PYTHON_MINOR=3.12

HADOOP_HOME=/opt/hadoop
SPARK_HOME=/opt/spark
ICEBERG_JAR=iceberg-spark-runtime-3.5_${SCALA_BINARY}-${ICEBERG_VERSION}.jar

HADOOP_URL=https://archive.apache.org/dist/hadoop/common/hadoop-${HADOOP_VERSION}/hadoop-${HADOOP_VERSION}.tar.gz
SPARK_URL=https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz
ICEBERG_URL=https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_${SCALA_BINARY}/${ICEBERG_VERSION}/${ICEBERG_JAR}
